<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.14</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>co.za</groupId>
	<artifactId>KoKoApp</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name/>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
	</properties>

	<!-- AWS SDK BOM - pins consistent versions across AWS SDK modules so
	     the s3 dependency below doesn't need its own <version>. R2 speaks
	     the S3 API, so this same SDK talks to Cloudflare R2 unmodified,
	     just pointed at R2's endpoint instead of AWS's (see R2Config). -->
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>software.amazon.awssdk</groupId>
				<artifactId>bom</artifactId>
				<version>2.49.6</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-thymeleaf</artifactId>
		</dependency>

		<!-- Spring Data JPA — the ORM layer that maps the User entity
		     to a table and gives us JpaRepository for free (save, findBy...,
		     etc.) without hand-writing SQL. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- PostgreSQL JDBC driver — the actual wire-protocol client that
		     talks to Neon. Spring Data JPA needs this underneath it;
		     without it there's nothing to actually open a connection with. -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Spring Security — pulled in purely for BCryptPasswordEncoder
		     to hash passwords. IMPORTANT: adding this locks every endpoint
		     behind a default login wall unless explicitly opened back up -
		     see SecurityConfig, which permits all requests for now since
		     we're building our own JWT-based auth later, not using Spring
		     Security's session login. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<!-- AWS SDK S3 module — used to talk to Cloudflare R2, not AWS.
		     R2 exposes an S3-compatible API, so this standard client
		     works unmodified once pointed at R2's endpoint (see R2Config). -->
		<dependency>
			<groupId>software.amazon.awssdk</groupId>
			<artifactId>s3</artifactId>
		</dependency>

		<!-- Enables Django/Jinja-style template inheritance for Thymeleaf:
		     layout:decorate on a child page + layout:fragment blocks that
		     override sections of a parent layout. Spring Boot auto-detects
		     this on the classpath and registers the dialect automatically -
		     no extra config bean needed. -->
		<dependency>
			<groupId>nz.net.ultraq.thymeleaf</groupId>
			<artifactId>thymeleaf-layout-dialect</artifactId>
			<version>3.3.0</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>